# Copy to .env and fill in. README.md explains deployment and the optional services.

# --- Required ---------------------------------------------------------------
# Public URL of the members site, used in links sent by mail.
BASE_URL=https://sos.example.org
# URL of the committee site, on its own host name.
ADMIN_BASE_URL=https://comite.sos.example.org
# 32 random bytes in base64: `openssl rand -base64 32`. Data and backups are
# unreadable without it: keep a copy apart from the backups, never change it.
SECRET_KEY=
# Identifier of the account that creates the others on the committee site.
# Set it here first; once the service runs, create the account and get its
# temporary password with:
#   docker compose exec app /sos-vpdive reset-password -name "First name" -role "Function" <identifier>
OWNER_USERNAME=
# Mail relay: acknowledgements, replies, club alerts.
# The connection is always encrypted: implicit TLS (465) or STARTTLS (587).
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_TLS=implicit
MAIL_FROM="Support du club <support@example.org>"
# Club mailbox: receives alerts, and is shown as the club's contact address.
NOTIFY_EMAIL=club@example.org

# --- Required in production -------------------------------------------------
# Cloudflare Turnstile widget created for both host names.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# S3-compatible storage for screenshots (Cloudflare R2, EU jurisdiction).
S3_ENDPOINT=https://ACCOUNT.eu.r2.cloudflarestorage.com
S3_BUCKET=change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=auto

# --- Optional ---------------------------------------------------------------
# development allows http URLs and running without Turnstile and S3.
APP_ENV=production
PORT=8080
DATA_DIR=/data
# CIDR ranges of the reverse proxy, comma-separated: only they may set
# X-Forwarded-For and traceparent. The default is the gateway of the network
# pinned in compose.yaml, i.e. the address the app sees when a reverse proxy on
# the host connects to 127.0.0.1:8080.
TRUSTED_PROXIES=172.30.30.1/32
LOG_LEVEL=info
# Your club's VPDive site.
VPDIVE_BASE_URL=https://vpdive.example.org
# Age of the members import after which the committee sees a reminder.
MEMBERS_MAX_AGE=336h
# Age of the payments import after which the committee sees a reminder.
PAYMENTS_MAX_AGE=168h
# Age of the VPayDive import after which the committee sees a reminder.
VPAYDIVE_MAX_AGE=168h
# Age of the latest calendar pushed by the script after which the committee
# sees a reminder.
CALENDAR_MAX_AGE=48h
# Age of the latest carnet cards pushed by the script after which the
# committee sees a reminder.
CARNETS_MAX_AGE=48h

# Token of the script that pushes the exports (README, "Pushed imports"), 32
# characters at least: openssl rand -base64 32. Empty turns the route off.
IMPORT_TOKEN=
# Age of an open request at which the board shows it in orange, then in red.
AGE_WARN_AFTER=48h
AGE_ALERT_AFTER=168h
# Days a closed request is kept before deletion, 15 to 3650 (monthly counters remain).
RETENTION_DAYS=365
# Form submissions accepted per hour from one IP address.
FORM_RATE_LIMIT=20/h
# Fiche suggestions before sending (README, "Fiche suggestions").
# Without a key, requests leave at once and the board shows the start of the
# description.
LLM_API_KEY=
# Any provider that speaks Anthropic's Messages API, for example
# https://api.deepseek.com/anthropic with LLM_MODEL=deepseek-v4-pro.
# claude-haiku-5-5 was the fastest of the most accurate in our tests
# (docs/adr/0002).
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-haiku-5-5
# Past this delay the request leaves without suggestions.
LLM_TIMEOUT=8s
# Model calls per day (Europe/Paris); past it, requests leave at once.
LLM_DAILY_LIMIT=200
# Committee assistant, off by default; needs ASSISTANT_API_KEY. It has its
# own provider: the LLM_* variables above are the suggestions'.
ASSISTANT_ENABLED=false
ASSISTANT_API_KEY=
# Any provider that speaks Anthropic's Messages API with tool use.
ASSISTANT_BASE_URL=https://api.anthropic.com
# claude-sonnet-5-5 at effort high gave the best answers in our tests
# (docs/adr/0002).
ASSISTANT_MODEL=claude-sonnet-5-5
# Reasoning before answering (true or false); true when empty.
ASSISTANT_THINKING=true
# How much the model reasons and writes: low, medium, high, xhigh or max; the
# provider's default when empty. xhigh and max need ASSISTANT_THINKING=true
# and are ignored without it (Claude Sonnet 5.5 refuses them then).
ASSISTANT_EFFORT=high
# Tokens per model call, reasoning included; 32000 when empty, 8000 without reasoning.
ASSISTANT_MAX_TOKENS=
# Questions per committee account and day.
ASSISTANT_DAILY_QUESTIONS=50
# Prices in dollars per million tokens, for the usage journal; no cost shown
# when empty. A cache write counts 1.25 times the input price.
# Claude Sonnet 5.5: 2, 10 and 0.2.
ASSISTANT_PRICE_INPUT=
ASSISTANT_PRICE_OUTPUT=
ASSISTANT_PRICE_CACHED=
# Committee alerts besides the club mailbox (README, "Committee alerts").
# Pushover: the application token. Each resolver who wants the alerts sets
# their user key on the « Notifications » page.
PUSHOVER_APP_TOKEN=
# Web Push to the installed committee app: `sos-vpdive vapid-keys` prints a
# key pair. Set all three or none. The subject is a bare address such as
# mailto:club@example.org, without < >: Apple refuses a bracketed one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Push services a phone may subscribe through; a leading dot accepts any
# subdomain. The default covers Chrome, Safari, Firefox and Edge.
PUSH_ALLOWED_HOSTS=fcm.googleapis.com,web.push.apple.com,updates.push.services.mozilla.com,.notify.windows.com
# Standard OpenTelemetry variables. Without an endpoint, nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=support-vpdive-cpp
OTEL_TRACES_SAMPLER=parentbased_always_on
# Ratio for a ratio sampler (parentbased_traceidratio), from 0 to 1.
OTEL_TRACES_SAMPLER_ARG=
# Usage and errors (README, "Usage and errors"), both optional. An invalid
# value turns the tool off with a warning; the service starts anyway.
# Umami page views: your instance's script, on another origin than both
# sites, then one website ID per site. A site without an ID is not measured.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_ADMIN_WEBSITE_ID=
# Sentry: errors, logs and traces of the server. Always off with
# APP_ENV=development. The environment defaults to APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# WebMCP: browser agents (Chrome) may fill the member form; the member
# still checks it and sends it. Chrome's origin-trial token for BASE_URL's
# origin, at https://developer.chrome.com/origintrials. Empty: only browsers
# with WebMCP turned on in chrome://flags see the form as a tool.
WEBMCP_ORIGIN_TRIAL=
