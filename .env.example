# Copy to .env and fill in. README.md describes every variable.

# --- Required ---------------------------------------------------------------
# Public URL of the members site, used in links sent by mail.
BASE_URL=https://sos.example.org
# URL of the committee site, on its own host name.
ADMIN_BASE_URL=https://comite.sos.example.org
# 32 random bytes in base64: `openssl rand -base64 32`. Data and backups are
# unreadable without it: keep a copy apart from the backups, never change it.
SECRET_KEY=
# Mail relay: acknowledgements, replies, club alerts.
# The connection is always encrypted: implicit TLS (465) or STARTTLS (587).
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_TLS=implicit
MAIL_FROM="Support du club <support@example.org>"
# Club mailbox: receives alerts, and is shown as the club's contact address.
NOTIFY_EMAIL=club@example.org

# --- Required in production -------------------------------------------------
# Cloudflare Turnstile widget created for both host names.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# S3-compatible storage for screenshots (Cloudflare R2, EU jurisdiction).
S3_ENDPOINT=https://ACCOUNT.eu.r2.cloudflarestorage.com
S3_BUCKET=change-me
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=auto

# --- Optional ---------------------------------------------------------------
# development allows http URLs and running without Turnstile and S3.
APP_ENV=production
PORT=8080
DATA_DIR=/data
ADMINS_FILE=/config/admins.yaml
# CIDR ranges of the reverse proxy, comma-separated: only they may set
# X-Forwarded-For and traceparent. The default is the gateway of the network
# pinned in compose.yaml, i.e. the address the app sees when a reverse proxy on
# the host connects to 127.0.0.1:8080.
TRUSTED_PROXIES=172.30.30.1/32
LOG_LEVEL=info
# Your club's VPDive site.
VPDIVE_BASE_URL=https://vpdive.example.org
# Age of the members import after which the committee sees a reminder.
MEMBERS_MAX_AGE=336h
# Age of an open request at which the board shows it in orange, then in red.
AGE_WARN_AFTER=48h
AGE_ALERT_AFTER=168h
# Days a closed request is kept before deletion, 15 to 3650 (monthly counters remain).
RETENTION_DAYS=365
# Form submissions accepted per hour from one IP address.
FORM_RATE_LIMIT=20/h
# Standard OpenTelemetry variables. Without an endpoint, nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=support-vpdive-cpp
OTEL_TRACES_SAMPLER=parentbased_always_on
